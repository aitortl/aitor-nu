---
layout: base.njk
titulo: Actividad
descripcion: Ponencias, pósteres y comunicaciones a congresos de Aitor Trabanco LLano, además de eventos y apariciones en medios.
permalink: /actividad/
---
{% import "listas.njk" as l %}
<header class="cabecera">
  <h1>Actividad</h1>
  <p class="lede">He presentado mis trabajos en congresos nacionales e internacionales como ponencias, pósteres y comunicaciones. También divulgo: he participado en jornadas para pacientes, mesas redondas y charlas en centros educativos, y he hablado de nutrición en radio y prensa, en representación del CODiNuPA, del Consejo General de Colegios Oficiales de Dietistas-Nutricionistas y de la Fundación Española de la Nutrición.</p>
</header>

{% set proximos = eventos.entradas | proximos %}
{% if proximos.length %}
<section class="bloque">
  <h2>Próximos eventos</h2>
  <ul class="lista">
    {% for e in proximos %}{{ l.evento(e) }}{% endfor %}
  </ul>
</section>
{% endif %}

{% if comunicaciones.entradas.length %}
<section class="bloque" id="comunicaciones">
  <h2>Comunicaciones a congresos</h2>
  <ul class="lista">
    {% for c in comunicaciones.entradas | ordenarComunicaciones %}{{ l.comunicacion(c) }}{% endfor %}
  </ul>
</section>
{% endif %}

{% set anteriores = eventos.entradas | pasados %}
{% if anteriores.length %}
<section class="bloque" id="eventos-anteriores">
  <h2>Eventos anteriores</h2>
  <ul class="lista">
    {% for e in anteriores %}{{ l.evento(e) }}{% endfor %}
  </ul>
</section>
{% endif %}

{% if medios.entradas.length %}
<section class="bloque" id="en-los-medios">
  <h2>En los medios</h2>
  <ul class="lista">
    {% for m in medios.entradas | ordenarPorFecha %}{{ l.medio(m) }}{% endfor %}
  </ul>
</section>
{% endif %}
