---
layout: base.njk
titulo: Publicaciones
descripcion: "Capítulo en la obra de Dietoterapia de la SEEN, resúmenes de congreso, guías divulgativas y participación en proyectos de investigación en nutrición, con enlace a la fuente."
permalink: /publicaciones/
---
{% import "listas.njk" as l %}
<header class="cabecera">
  <h1>Publicaciones</h1>
  <p class="lede">Soy coautor de un capítulo en la obra de Dietoterapia dirigida por la SEEN y de guías y documentos divulgativos elaborados con la Fundación Española de la Nutrición. He participado, como miembro del equipo, en proyectos de investigación y he presentado mis trabajos en congresos.</p>
</header>

{% set capitulos = publicaciones.entradas | deTipo("capitulo") | ordenarPorFecha("anio") %}
{% if capitulos.length %}
<section class="bloque">
  <h2>{{ "Capítulos" if capitulos.length > 1 else "Capítulo" }} de libro</h2>
  <ul class="lista">
    {% for p in capitulos %}{{ l.publicacion(p) }}{% endfor %}
  </ul>
</section>
{% endif %}

{% set resumenes = publicaciones.entradas | deTipo("resumen") | ordenarPorFecha("anio") %}
{% if resumenes.length %}
<section class="bloque">
  <h2>{{ "Resúmenes" if resumenes.length > 1 else "Resumen" }} de congreso</h2>
  <ul class="lista">
    {% for p in resumenes %}{{ l.publicacion(p) }}{% endfor %}
  </ul>
</section>
{% endif %}

{% set guias = publicaciones.entradas | deTipo("guia", "dossier") | ordenarPorFecha("anio") %}
{% if guias.length %}
<section class="bloque">
  <h2>Documentos divulgativos y guías</h2>
  <ul class="lista">
    {% for p in guias %}{{ l.publicacion(p) }}{% endfor %}
  </ul>
</section>
{% endif %}

{% if proyectos.entradas.length %}
<section class="bloque">
  <h2>Participación en proyectos</h2>
  <ul class="simple amplia" style="--columnas:3">
    {% for p in proyectos.entradas %}<li>{% if p.enlace %}<a href="{{ p.enlace }}">{{ p.texto | texto | safe }}</a>{% else %}{{ p.texto | texto | safe }}{% endif %}
      {%- if p.enlaces and p.enlaces.length %} {% for e in p.enlaces %}<a href="{{ e.url }}">{{ e.texto }}</a>{{ ", " if not loop.last and loop.revindex > 2 else (" y " if loop.revindex == 2 else ".") }}{% endfor %}{% endif %}</li>{% endfor %}
  </ul>
</section>
{% endif %}

<section class="bloque">
  <h2>Perfiles</h2>
  <ul class="simple">
    {% if sitio.orcid %}<li><a href="https://orcid.org/{{ sitio.orcid }}">ORCID {{ sitio.orcid }}</a></li>{% endif %}
    {% if sitio.ispa and sitio.mostrar_ispa %}<li><a href="{{ sitio.ispa }}">Ficha de investigador en el ISPA-FINBA</a></li>{% endif %}
    <li><a href="{{ sitio.dialnet }}">Perfil de autor en Dialnet</a></li>
  </ul>
</section>
