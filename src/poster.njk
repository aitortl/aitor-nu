---
layout: base.njk
pagination:
  data: posteres
  size: 1
  alias: p
permalink: "/posteres/{{ p.slug }}/"
visor: true
eleventyComputed:
  titulo: "Póster: {{ p.titulo }}"
  descripcion: "Póster «{{ p.titulo }}», presentado en {{ p.evento }}."
---
{# Paso de un póster a otro, en bucle: del último se pasa al primero. #}
{% set total = pagination.pages.length %}
{% set i = pagination.pageNumber %}
{% set anterior = pagination.pages[(i - 1 + total) % total] %}
{% set siguiente = pagination.pages[(i + 1) % total] %}
{% macro entrePosteres() %}
<nav class="entre-posteres" aria-label="Otros pósteres">
  <a class="previo" href="{{ pagination.hrefs[(i - 1 + total) % total] }}" rel="prev" data-tecla="ArrowLeft"><span class="sentido">← Anterior</span><span class="nombre">{{ anterior.titulo }}</span></a>
  <span class="cuenta">{{ i + 1 }} de {{ total }}</span>
  <a class="siguiente" href="{{ pagination.hrefs[(i + 1) % total] }}" rel="next" data-tecla="ArrowRight"><span class="sentido">Siguiente →</span><span class="nombre">{{ siguiente.titulo }}</span></a>
</nav>
{% endmacro %}
<header class="cabecera cabecera-poster">
  <p class="atras"><a href="/actividad/#comunicaciones" data-atras>← Volver</a></p>
  <h1>{{ p.titulo }}</h1>
  <p class="lede">Póster · {{ p.evento }} · {{ p.fecha | fecha }}{% if p.firma %} · {{ p.firma | firma | safe }}{% endif %}</p>
</header>

<section class="bloque">
  {% if total > 1 %}{{ entrePosteres() }}{% endif %}
  <div class="visor" data-pdf="{{ p.pdf }}">
    <div class="visor-barra">
      <div class="visor-zoom" hidden>
        <button class="control" type="button" data-zoom="-1" aria-label="Reducir">−</button>
        <button class="control" type="button" data-zoom="1" aria-label="Ampliar">+</button>
        <button class="control control-texto" type="button" data-zoom="0">Ajustar</button>
      </div>
      <a class="visor-descarga" href="{{ p.pdf }}" download>Descargar PDF ({{ p.megas }} MB)</a>
    </div>
    <div class="visor-lienzo" tabindex="0" role="document" aria-label="Póster «{{ p.titulo }}»">
      <p class="visor-aviso">Si el póster no se muestra, <a href="{{ p.pdf }}">ábrelo en PDF</a>.</p>
    </div>
  </div>
  {% if total > 1 %}{{ entrePosteres() }}{% endif %}
  <p class="volver"><a href="/actividad/#comunicaciones" data-atras>← Volver</a></p>
</section>
