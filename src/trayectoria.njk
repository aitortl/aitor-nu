---
layout: base.njk
titulo: Trayectoria
descripcion: Experiencia profesional y formación de Aitor Trabanco LLano, Dietista-Nutricionista.
permalink: /trayectoria/
---
{% import "listas.njk" as l %}
<header class="cabecera">
  <h1>Trayectoria</h1>
  <p class="lede">Trabajo como dietista-nutricionista en el ámbito clínico y en la investigación; la docencia y la divulgación forman parte de mi trayectoria desde 2018. Hoy atiendo consulta hospitalaria en el Hospital Universitario de Cabueñes, dentro del grupo ENDO del ISPA, y lo compagino con NutriMed Clinical Nutrition, la docencia online y la secretaría del CODiNuPA.</p>
</header>

{% set ahora = trayectoria.entradas | enCurso %}
{% if ahora.length %}
<section class="bloque">
  <h2>Ahora</h2>
  <ul class="lista">
    {% for t in ahora %}{{ l.trayectoria(t) }}{% endfor %}
  </ul>
</section>
{% endif %}

{% set antes = trayectoria.entradas | terminados %}
{% if antes.length %}
<section class="bloque">
  <h2>Antes</h2>
  <ul class="lista">
    {% for t in antes %}{{ l.trayectoria(t) }}{% endfor %}
  </ul>
</section>
{% endif %}

{% if formacion.entradas.length %}
<section class="bloque">
  <h2>Formación</h2>
  <ul class="lista">
    {% for f in formacion.entradas | ordenarPorFecha("fin") %}{% if f.universitaria %}{{ l.formacion(f) }}{% endif %}{% endfor %}
    {% for f in formacion.entradas | ordenarPorFecha("fin") %}{% if not f.universitaria %}{{ l.formacion(f) }}{% endif %}{% endfor %}
  </ul>
</section>
{% endif %}

{% if reconocimientos.entradas.length %}
<section class="bloque">
  <h2>Reconocimientos, idiomas y herramientas</h2>
  <ul class="simple">
    {% for r in reconocimientos.entradas %}<li>{{ r | texto | safe }}</li>{% endfor %}
  </ul>
</section>
{% endif %}
