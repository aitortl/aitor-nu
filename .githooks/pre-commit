#!/bin/sh
# Antes de cada commit, borra los metadatos (GPS, cámara, autor...) de las imágenes
# de src/img y de los PDF de src/documentos nuevos o modificados, y vuelve a añadirlos
# al commit ya limpios.
imagenes=$(git diff --cached --name-only --diff-filter=AM -- 'src/img/*' 'src/documentos/*' | grep -iE '\.(jpe?g|png|webp|pdf)$')
[ -z "$imagenes" ] && exit 0
limpias=$(echo "$imagenes" | tr '\n' '\0' | xargs -0 node scripts/limpiar-metadatos.js) || exit 1
if [ -n "$limpias" ]; then
  echo "Metadatos borrados de:"
  echo "$limpias" | sed 's/^/  /'
  echo "$limpias" | tr '\n' '\0' | xargs -0 git add --
fi
